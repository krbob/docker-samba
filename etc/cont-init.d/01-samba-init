#!/command/with-contenv sh
# shellcheck shell=sh
set -e

# Defaults
: "${SHARE_NAME:=public}"
: "${SHARE_PATH:=/share}"
: "${WORKGROUP:=WORKGROUP}"
: "${SERVER_STRING:=Samba Server}"
: "${FORCE_USER_UID:=1000}"
: "${FORCE_GROUP_GID:=1000}"
: "${SHARE_DIR_MODE:=}"
: "${LOG_LEVEL:=1}"
: "${SAMBA_INTERFACES:=}"
: "${SAMBA_BIND_INTERFACES_ONLY:=}"
: "${SMB_ENCRYPT:=}"
: "${SMB_SIGNING:=}"
: "${SAMBA_PASSWORD:=}"
: "${SAMBA_PASSWORD_FILE:=}"
: "${READ_ONLY:=}"
: "${CREATE_MASK:=0664}"
: "${DIRECTORY_MASK:=0775}"
: "${RECYCLE_ENABLE:=}"
: "${RECYCLE_REPOSITORY:=.recycle}"
: "${RECYCLE_MAX_SIZE:=}"
: "${RECYCLE_EXCLUDE:=}"
: "${RECYCLE_EXCLUDE_DIR:=}"

HEALTHCHECK_AUTH_FILE="/run/samba/healthcheck.auth"

fail() {
  echo "$*" >&2
  exit 1
}

validate_octal_mode() {
  name="$1"
  value="$2"

  case "${value}" in
    [0-7][0-7][0-7] | [0-7][0-7][0-7][0-7]) ;;
    *) fail "${name} must be a 3- or 4-digit octal mode" ;;
  esac
}

validate_unsigned_integer() {
  name="$1"
  value="$2"

  case "${value}" in
    "" | *[!0-9]*) fail "${name} must be an unsigned integer" ;;
  esac
}

validate_single_line() {
  name="$1"
  value="$2"

  case "${value}" in
    *'
'*) fail "${name} must not contain newlines" ;;
  esac
}

validate_enum() {
  name="$1"
  value="$2"
  allowed_values="$3"

  validate_single_line "${name}" "${value}"
  [ -z "${value}" ] && return

  case " ${allowed_values} " in
    *" ${value} "*) ;;
    *) fail "${name} must be one of: ${allowed_values}" ;;
  esac
}

validate_relative_path() {
  name="$1"
  value="$2"

  validate_single_line "${name}" "${value}"
  case "${value}" in
    "" | /* | .. | ../* | */.. | */../*) fail "${name} must be a relative path inside SHARE_PATH" ;;
  esac
}

interfaces_include_loopback() {
  case " ${SAMBA_INTERFACES} " in
    *" lo "* | *" 127."* | *" localhost "*) return 0 ;;
    *) return 1 ;;
  esac
}

load_samba_password() {
  if [ -n "${SAMBA_PASSWORD}" ] && [ -n "${SAMBA_PASSWORD_FILE}" ]; then
    fail "Set only one of SAMBA_PASSWORD or SAMBA_PASSWORD_FILE"
  fi

  if [ -n "${SAMBA_PASSWORD_FILE}" ]; then
    [ -r "${SAMBA_PASSWORD_FILE}" ] || fail "SAMBA_PASSWORD_FILE is not readable: ${SAMBA_PASSWORD_FILE}"

    IFS= read -r SAMBA_PASSWORD < "${SAMBA_PASSWORD_FILE}" || [ -n "${SAMBA_PASSWORD}" ]
    [ -n "${SAMBA_PASSWORD}" ] || fail "SAMBA_PASSWORD_FILE is empty: ${SAMBA_PASSWORD_FILE}"
  fi

  if [ -n "${SAMBA_PASSWORD}" ]; then
    validate_single_line SAMBA_PASSWORD "${SAMBA_PASSWORD}"
  fi
}

ensure_samba_group() {
  if getent group samba >/dev/null; then
    current_gid="$(getent group samba | cut -d: -f3)"
    if [ "${current_gid}" != "${FORCE_GROUP_GID}" ]; then
      echo "Group samba already exists with GID ${current_gid}, expected ${FORCE_GROUP_GID}" >&2
      exit 1
    fi
    return
  fi

  existing_group="$(getent group "${FORCE_GROUP_GID}" | cut -d: -f1 || true)"
  if [ -n "${existing_group}" ]; then
    echo "Requested FORCE_GROUP_GID=${FORCE_GROUP_GID} already belongs to group ${existing_group}" >&2
    exit 1
  fi

  groupadd -g "${FORCE_GROUP_GID}" samba
}

ensure_samba_user() {
  if getent passwd samba >/dev/null; then
    current_uid="$(getent passwd samba | cut -d: -f3)"
    current_gid="$(getent passwd samba | cut -d: -f4)"
    samba_gid="$(getent group samba | cut -d: -f3)"
    if [ "${current_uid}" != "${FORCE_USER_UID}" ] || [ "${current_gid}" != "${samba_gid}" ]; then
      echo "User samba already exists with UID:GID ${current_uid}:${current_gid}, expected ${FORCE_USER_UID}:${samba_gid}" >&2
      exit 1
    fi
    return
  fi

  existing_user="$(getent passwd "${FORCE_USER_UID}" | cut -d: -f1 || true)"
  if [ -n "${existing_user}" ]; then
    echo "Requested FORCE_USER_UID=${FORCE_USER_UID} already belongs to user ${existing_user}" >&2
    exit 1
  fi

  useradd -u "${FORCE_USER_UID}" -g samba -M -s /sbin/nologin samba
}

write_healthcheck_auth() {
  install -d -m 0700 /run/samba

  if [ -n "${SAMBA_PASSWORD}" ]; then
    (
      umask 077
      {
        printf 'username = samba\n'
        printf 'password = %s\n' "${SAMBA_PASSWORD}"
        printf 'domain = %s\n' "${WORKGROUP}"
      } > "${HEALTHCHECK_AUTH_FILE}"
    )
  else
    rm -f "${HEALTHCHECK_AUTH_FILE}"
  fi
}

# Create samba group and user with configurable UID/GID
load_samba_password
ensure_samba_group
ensure_samba_user

validate_octal_mode CREATE_MASK "${CREATE_MASK}"
validate_octal_mode DIRECTORY_MASK "${DIRECTORY_MASK}"
validate_relative_path RECYCLE_REPOSITORY "${RECYCLE_REPOSITORY}"
if [ -n "${RECYCLE_MAX_SIZE}" ]; then
  validate_unsigned_integer RECYCLE_MAX_SIZE "${RECYCLE_MAX_SIZE}"
fi
validate_single_line RECYCLE_EXCLUDE "${RECYCLE_EXCLUDE}"
validate_single_line RECYCLE_EXCLUDE_DIR "${RECYCLE_EXCLUDE_DIR}"
validate_single_line SAMBA_INTERFACES "${SAMBA_INTERFACES}"
validate_enum SMB_ENCRYPT "${SMB_ENCRYPT}" "default if_required desired required off"
validate_enum SMB_SIGNING "${SMB_SIGNING}" "default auto mandatory disabled"

# Optional: SMB transport protection
if [ -n "${SMB_ENCRYPT}" ]; then
  SMB_ENCRYPT_LINE="  server smb encrypt = ${SMB_ENCRYPT}"
else
  SMB_ENCRYPT_LINE=""
fi

if [ -n "${SMB_SIGNING}" ]; then
  SMB_SIGNING_LINE="  server signing = ${SMB_SIGNING}"
else
  SMB_SIGNING_LINE=""
fi

# Optional: bind smbd to specific interfaces
if [ -n "${SAMBA_INTERFACES}" ]; then
  INTERFACES_LINE="  interfaces = ${SAMBA_INTERFACES}"
else
  INTERFACES_LINE=""
fi

if [ "${SAMBA_BIND_INTERFACES_ONLY}" = "1" ]; then
  [ -n "${SAMBA_INTERFACES}" ] || fail "SAMBA_BIND_INTERFACES_ONLY=1 requires SAMBA_INTERFACES"
  interfaces_include_loopback || fail "SAMBA_INTERFACES must include lo or 127.x.x.x when SAMBA_BIND_INTERFACES_ONLY=1"
  BIND_INTERFACES_ONLY_LINE="  bind interfaces only = yes"
else
  BIND_INTERFACES_ONLY_LINE=""
fi

if [ "${GUEST_OK}" = "1" ]; then
  if [ -n "${SAMBA_PASSWORD}" ]; then
    printf '%s\n%s\n' "${SAMBA_PASSWORD}" "${SAMBA_PASSWORD}" | smbpasswd -a -s samba
  else
    echo "GUEST_OK=1 and SAMBA_PASSWORD is unset; skipping SMB password setup"
  fi
else
  if [ -z "${SAMBA_PASSWORD}" ]; then
    echo "Set SAMBA_PASSWORD or enable GUEST_OK=1" >&2
    exit 1
  fi
  printf '%s\n%s\n' "${SAMBA_PASSWORD}" "${SAMBA_PASSWORD}" | smbpasswd -a -s samba
fi

write_healthcheck_auth

# Ensure share directory exists with correct ownership
mkdir -p "${SHARE_PATH}"
chown samba:samba "${SHARE_PATH}"

if [ -n "${SHARE_DIR_MODE}" ]; then
  chmod "${SHARE_DIR_MODE}" "${SHARE_PATH}"
fi

# Optional: restrict access to specific networks
if [ -n "${SAMBA_HOSTS_ALLOW}" ]; then
  HOSTS_ALLOW_LINE="  hosts allow = ${SAMBA_HOSTS_ALLOW}"
else
  HOSTS_ALLOW_LINE=""
fi

# Optional: guest access
if [ "${GUEST_OK}" = "1" ]; then
  GUEST_LINE="  guest ok = yes"
else
  GUEST_LINE="  valid users = samba"
fi

# Optional: read-only share
if [ "${READ_ONLY}" = "1" ]; then
  READ_ONLY_VALUE="yes"
else
  READ_ONLY_VALUE="no"
fi

# Optional: recycle bin for SMB deletes
VFS_OBJECTS="fruit streams_xattr"
if [ "${RECYCLE_ENABLE}" = "1" ]; then
  VFS_OBJECTS="recycle ${VFS_OBJECTS}"
  RECYCLE_LINES="  recycle:repository = ${RECYCLE_REPOSITORY}
  recycle:keeptree = yes
  recycle:versions = yes
  recycle:touch = yes"
  if [ -n "${RECYCLE_MAX_SIZE}" ]; then
    RECYCLE_LINES="${RECYCLE_LINES}
  recycle:maxsize = ${RECYCLE_MAX_SIZE}"
  fi
  if [ -n "${RECYCLE_EXCLUDE}" ]; then
    RECYCLE_LINES="${RECYCLE_LINES}
  recycle:exclude = ${RECYCLE_EXCLUDE}"
  fi
  if [ -n "${RECYCLE_EXCLUDE_DIR}" ]; then
    RECYCLE_LINES="${RECYCLE_LINES}
  recycle:exclude_dir = ${RECYCLE_EXCLUDE_DIR}"
  fi
else
  RECYCLE_LINES=""
fi

# Optional: follow symlinks
if [ "${FOLLOW_SYMLINKS}" = "1" ]; then
  SYMLINKS_LINE="  follow symlinks = yes
  wide links = yes
  unix extensions = no"
else
  SYMLINKS_LINE=""
fi

# Generate smb.conf from template
export SHARE_NAME SHARE_PATH WORKGROUP SERVER_STRING LOG_LEVEL HOSTS_ALLOW_LINE INTERFACES_LINE BIND_INTERFACES_ONLY_LINE
export SMB_ENCRYPT_LINE SMB_SIGNING_LINE
export SYMLINKS_LINE GUEST_LINE
export VFS_OBJECTS RECYCLE_LINES READ_ONLY_VALUE CREATE_MASK DIRECTORY_MASK
envsubst < /etc/samba/smb.conf.template > /etc/samba/smb.conf

# Optional: restrict Avahi to specific interfaces
if [ -n "${ALLOWED_INTERFACES}" ]; then
  sed -i "s/^#*allow-interfaces=.*/allow-interfaces=${ALLOWED_INTERFACES}/" /etc/avahi/avahi-daemon.conf
fi

# Validate configuration
echo "--- Samba configuration ---"
testparm -s /etc/samba/smb.conf 2>/dev/null
echo "---"
