# Copy this file to .env. It contains Compose interpolation settings only and
# must never contain the Samba password itself.

# Published image tag used by docker-compose.yml.
SAMBA_IMAGE_TAG=latest

# Keep the default loopback bind for local-only access. Change this only when
# the host firewall and trusted network exposure have been reviewed.
SAMBA_BIND_ADDRESS=127.0.0.1

# Host path to the file mounted as /run/secrets/samba_password.
SAMBA_PASSWORD_SECRET_FILE=./.secrets/samba_password

# Required only with docker-compose.discovery.yml. Replace both values with the
# actual host LAN interface and trusted client CIDR.
# SAMBA_LAN_INTERFACE=eno1
# SAMBA_LAN_NETWORK=192.168.1.0/24

# LLMNR remains disabled by default; enable only for clients that require it.
# WSDD2_LLMNR_ENABLE=0
