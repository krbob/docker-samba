#!/command/with-contenv sh
# shellcheck shell=sh

wsdd2_enable="$(printf '%s' "${WSDD2_ENABLE:-0}" | LC_ALL=C tr '[:upper:]' '[:lower:]')"
case "${wsdd2_enable}" in
  1|true|yes|on)
    ;;
  0|false|no|off|'')
    s6-svc -Od .
    exit 0
    ;;
  *)
    printf 'Invalid WSDD2_ENABLE value: %s\n' "${WSDD2_ENABLE}" >&2
    exit 1
    ;;
esac

set --

wsdd2_llmnr_enable="$(printf '%s' "${WSDD2_LLMNR_ENABLE:-0}" | LC_ALL=C tr '[:upper:]' '[:lower:]')"
case "${wsdd2_llmnr_enable}" in
  1|true|yes|on)
    ;;
  0|false|no|off|'')
    set -- "$@" -w
    ;;
  *)
    printf 'Invalid WSDD2_LLMNR_ENABLE value: %s\n' "${WSDD2_LLMNR_ENABLE}" >&2
    exit 1
    ;;
esac

if [ -n "${WSDD2_HOSTNAME}" ]; then
  set -- "$@" -H "${WSDD2_HOSTNAME}"
fi

if [ -n "${WSDD2_NETBIOS_NAME}" ]; then
  set -- "$@" -N "${WSDD2_NETBIOS_NAME}"
fi

if [ -n "${WSDD2_WORKGROUP}" ]; then
  set -- "$@" -G "${WSDD2_WORKGROUP}"
elif [ -n "${WORKGROUP}" ]; then
  set -- "$@" -G "${WORKGROUP}"
fi

if [ -n "${ALLOWED_INTERFACES}" ]; then
  old_ifs="${IFS}"
  IFS=','
  for iface in ${ALLOWED_INTERFACES}; do
    set -- "$@" -i "${iface}"
  done
  IFS="${old_ifs}"
fi

printf 'Starting wsdd2'
for arg do
  printf ' %s' "${arg}"
done
printf '\n'

exec s6-setuidgid wsdd2 wsdd2 "$@"
