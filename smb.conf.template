[global]
  workgroup = ${WORKGROUP}
  server string = ${SERVER_STRING}
  server role = standalone server

  # Logging
  log level = ${LOG_LEVEL}
  log file = /dev/stdout
  max log size = 0

  # Security
  security = user
  map to guest = Bad User
${SMB_ENCRYPT_LINE}
${SMB_SIGNING_LINE}
${HOSTS_ALLOW_LINE}
${INTERFACES_LINE}
${BIND_INTERFACES_ONLY_LINE}
  # Disable unnecessary services
  disable netbios = yes
  smb ports = 445
  dns proxy = no
  load printers = no
  printing = bsd
  printcap name = /dev/null
  usershare max shares = 0

  # Identity mapping
  idmap config * : backend = tdb
  idmap config * : range = 3000-7999

  # Protocol
  server min protocol = SMB2
  server max protocol = SMB3

  # macOS compatibility and optional recycle bin
  vfs objects = ${VFS_OBJECTS}
  fruit:metadata = stream
  fruit:model = MacSamba
  fruit:nfs_aces = no
  fruit:wipe_intentionally_left_blank_rfork = yes
  fruit:delete_empty_adfiles = yes
${RECYCLE_LINES}

${SYMLINKS_LINE}
  # Performance
  socket options = TCP_NODELAY IPTOS_LOWDELAY
  use sendfile = yes
  aio read size = 16384
  aio write size = 16384

[${SHARE_NAME}]
  path = ${SHARE_PATH}
  browseable = yes
  read only = ${READ_ONLY_VALUE}
${GUEST_LINE}
  create mask = ${CREATE_MASK}
  directory mask = ${DIRECTORY_MASK}
  force user = samba
  force group = samba
  nt acl support = no
  veto files = /._*/.DS_Store/.Thumbs.db/desktop.ini/.apdisk/.AppleDouble/.TemporaryItems/.Trashes/
  delete veto files = yes
